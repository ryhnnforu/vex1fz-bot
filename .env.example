# ═══════════ VEX1FZ BOT — salin jadi ".env" lalu isi ═══════════

# Nomor bot (format internasional tanpa +) untuk pairing kode
BOT_NUMBER=6281234567890

# Mode login: pairing | qr
LOGIN_MODE=pairing

# Mode bot: public | self
BOT_MODE=public

# Port server game (di panel Pterodactyl ikuti allokasi panelmu)
PORT=8080

# URL publik untuk akses game HTML dari HP user
# Termux: biarkan kosong (http://localhost:8080)
# Panel  : PUBLIC_URL=https://domain-panel-kamu:PORT_ALLOKASI
PUBLIC_URL=

# API key downloader (opsional)
LOLHUMAN_APIKEY=

# Endpoint downloader custom (pisahkan koma jika lebih dari satu)
# INSTAGRAM_API=https://api.contoh.com/ig?url={url}&apikey={apikey}
# FACEBOOK_API=
# TWITTER_API=
